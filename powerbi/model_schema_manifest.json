      "rows": 500,
      "primary_key": "LoanID"
    },
    "DimBorrower": {
      "type": "Dimension",
      "rows": 500,
      "primary_key": "BorrowerID"
    },
    "DimGeography": {
      "type": "Dimension",
      "rows": 19,
      "primary_key": "State"
    },
    "DimDate": {
      "type": "Dimension",
      "rows": 11,
      "primary_key": "SnapshotDate"
    },
    "FactMonthlyPerformance": {
      "type": "Fact",
      "rows": 6000,
      "foreign_keys": [
        "LoanID",
        "SnapshotDate"
      ]
    },
    "FactDynamicLoss": {
      "type": "Fact",
      "rows": 12,
      "foreign_keys": [
        "ReportingDate"
      ]
    }
  },
  "relationships": [
    {
