      "to": "DimLoan.LoanID",
      "cardinality": "N:1"
    },
    {
      "from": "FactMonthlyPerformance.SnapshotDate",
      "to": "DimDate.SnapshotDate",
      "cardinality": "N:1"
    },
    {
      "from": "DimLoan.BorrowerID",
      "to": "DimBorrower.BorrowerID",
      "cardinality": "N:1"
    },
    {
      "from": "DimLoan.State",
      "to": "DimGeography.State",
      "cardinality": "N:1"
    },
    {
      "from": "FactDynamicLoss.ReportingDate",
      "to": "DimDate.SnapshotDate",
      "cardinality": "N:1"
    }
  ]
}